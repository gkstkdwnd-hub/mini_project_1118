<script>
  function switchSeasonMode(season) {
    const tabs = {
      spring: document.getElementById('tab-spring'),
      autumn: document.getElementById('tab-autumn'),
      both: document.getElementById('tab-both')
    };

    // Reset all tabs styling
    Object.keys(tabs).forEach(key => {
      const tab = tabs[key];
      tab.classList.remove('bg-primary', 'text-white', 'font-bold', 'shadow-sm');
      tab.classList.add('text-on-surface-variant');
      tab.setAttribute('aria-selected', 'false');
    });

    // Activate selected tab
    const activeTab = tabs[season];
    activeTab.classList.remove('text-on-surface-variant');
    activeTab.classList.add('bg-primary', 'text-white', 'font-bold', 'shadow-sm');
    activeTab.setAttribute('aria-selected', 'true');
  }
