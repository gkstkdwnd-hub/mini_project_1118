        </p>
</div>
</div>
<script>
      (function initCalculator() {
        const buttons = document.querySelectorAll('.time-btn');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            buttons.forEach((b) => {
              b.className = 'time-btn px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-600 text-[11px] font-mono hover:text-on-surface transition-colors';
            });
            btn.className = 'time-btn px-2 py-0.5 rounded bg-primary text-white border border-primary text-[11px] font-mono font-semibold shadow-sm transition-colors';
          });
        });
      })();
    </script>
</main>
